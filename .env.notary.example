# Copy this file to `.env.notary` (git-ignored) and fill in ONE option.
# scripts/build-signed.sh reads it to notarize the build. Never commit secrets.

# ── Option A — App Store Connect API key (recommended) ───────────────────────
# App Store Connect → Users and Access → Integrations → App Store Connect API →
# generate a Team key with the "Developer" role, download the .p8 (once!), and
# note the Key ID + Issuer ID.
# APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # Issuer ID (UUID)
# APPLE_API_KEY=XXXXXXXXXX                                # Key ID
# APPLE_API_KEY_PATH=/Users/davo/.appstoreconnect/AuthKey_XXXXXXXXXX.p8

# ── Option B — Apple ID + app-specific password (simplest) ───────────────────
# appleid.apple.com → Sign-In & Security → App-Specific Passwords → generate one.
# APPLE_ID=you@example.com
# APPLE_PASSWORD=abcd-efgh-ijkl-mnop      # the app-specific password
# APPLE_TEAM_ID=PS6476ZWK5
