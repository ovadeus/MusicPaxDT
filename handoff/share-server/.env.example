# Share-server environment. Copy to `.env` (git-ignored) and fill in, then run:
#   node --env-file=handoff/share-server/.env handoff/share-server/standalone.js
#
# Your Resend API key. Get it at https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# From address on the email.
#   • Until you verify a domain in Resend, use onboarding@resend.dev — but it
#     ONLY delivers to the email address your Resend account is registered with
#     (great for a first test).
#   • For sending to anyone, verify a domain in Resend (Domains → Add) and use an
#     address on it, e.g.  MusicPax <share@musicpax.com>
SHARE_FROM=MusicPax <onboarding@resend.dev>

# Public origin used in the emailed link. Local test: http://localhost:3001.
# Production: the public URL where this server runs, e.g. https://musicpax.com
SHARE_BASE_URL=http://localhost:3001
PORT=3001

# Where the email/landing "Get the MusicPax app" button points.
APP_DOWNLOAD_URL=https://github.com/ovadeus/MusicPaxDT/releases

# Optional persistence (in-memory otherwise — shares vanish on restart).
# REPLIT_DB_URL=
